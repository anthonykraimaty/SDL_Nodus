# Database (Docker PostgreSQL)
# For Docker: use container name 'nodus_postgres'
# For local dev: use 'localhost'
DATABASE_URL=postgresql://nodus_user:YOUR_SECURE_PASSWORD@nodus_postgres:5432/nodus_db?schema=public

# Server
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173

# JWT Authentication - CHANGE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Backblaze B2 Cloud Storage (Optional - leave empty for local storage)
# Get these from Backblaze Dashboard > App Keys
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# B2 Public URL (your B2 friendly URL or CDN)
# Example: https://f004.backblazeb2.com/file/your-bucket-name
B2_PUBLIC_URL=

# Docker Backend Port (external port mapping)
BACKEND_PORT=5020

# =============================================================================
# KEYCLOAK — connexion avec un compte Scouts du Liban (voir docs/KEYCLOAK.md)
# =============================================================================
# Leave KEYCLOAK_URL empty to keep the email + password login only.

KEYCLOAK_URL=https://inscription-auth.scoutsduliban.org
KEYCLOAK_REALM=QG_CMS
OIDC_CLIENT_ID=nodus
# From the client's Credentials tab. Required for: the Admin → Accès dropdowns,
# the groups fallback, and the Inscription troupe auto-link.
OIDC_CLIENT_SECRET=

# The public origin of THIS API — the OIDC redirect URI is built from it.
# Behind nginx this must be the public URL, not localhost.
PUBLIC_BASE_URL=http://localhost:3001

# Admin hostname of the same Keycloak, when the public one blocks /admin/
# (SDL does). Only used to list groups and roles for the admin page.
# KEYCLOAK_ADMIN_URL=https://admin.auth.scoutsduliban.org

# --- Access rules pinned by configuration -----------------------------------
# These always count, on top of the Admin → Accès page, and cannot be removed
# from the UI — so nobody can lock themselves out. Syntax, comma separated:
#   admin            a role on nodus's own Keycloak client
#   realm:Read_QG    a realm role
#   /CU              membership of that group (or a subgroup)

# Who becomes an ADMIN.
KEYCLOAK_ADMIN_ROLES=admin
# Who may approve pictures for EVERY branche. Normally left empty: per-branche
# approval is set on Admin → Accès so Eclaireurs and Eclaireuses can differ.
KEYCLOAK_APPROVE_ROLES=
# Who may upload for their troupe.
KEYCLOAK_CHEF_ROLES=
# Who may sign in at all. Empty = every account of the realm.
KEYCLOAK_LOGIN_ROLES=

# --- Inscription (QG) API ----------------------------------------------------
# Used at sign-in to read the chief's profile and link them to their troupe.
SDL_REGISTRY_URL=https://inscription-api.scoutsduliban.org/api
# Set to false to assign every troupe by hand in Admin → Utilisateurs.
INSCRIPTION_AUTO_LINK_TROUPE=true

# --- Password login ---------------------------------------------------------
# Defaults to false as soon as Keycloak is configured. Set to true only during
# a transition, to let existing nodus passwords keep working.
# LOCAL_LOGIN=false

# --- Break-glass administrator ----------------------------------------------
# Signs in on the password form even when Keycloak is down. Always ADMIN; the
# password is compared against this file on every sign-in and never stored.
# In production it must be 12+ characters and not a placeholder.
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Administrateur de secours
